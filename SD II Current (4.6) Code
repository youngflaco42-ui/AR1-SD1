
#include <Servo.h>
#include <LedControl.h>
#include <PS2X_lib.h>  // PS2 controller library
// ============================================================
// PIN MAP
// ============================================================
// MAX7219 8×8 LED MATRIX
const int MATRIX_DIN = 11;
const int MATRIX_CLK = 13;
const int MATRIX_CS  = 12;
// SERVOS
const int S1_PIN = 26;
const int S2_PIN = 27;
const int S3_PIN = 28;
const int S4_PIN = 29;
const int S5_PIN = 30;
// PS2 CONTROLLER
const int PS2_DAT = 50;  // Data
const int PS2_CMD = 51;  // Command
const int PS2_SEL = 52;  // Select
const int PS2_CLK = 53;  // Clock
// ============================================================
// LED MATRIX
LedControl lc = LedControl(MATRIX_DIN, MATRIX_CLK, MATRIX_CS, 1);
// ============================================================
// SERVOS
Servo s1, s2, s3, s4, s5;
int currentPos[5] = {90, 90, 90, 90, 90};
int targetPos[5]  = {90, 90, 90, 90, 90};
// Servo safe ranges
const int MIN_SERVO[5] = {0, 20, 10, 0, 0};
const int MAX_SERVO[5] = {180, 160, 170, 180, 180};
const int STEP_SIZE = 1.5;
const unsigned long STEP_DT = 30;
unsigned long lastStepTime = 0;
// ============================================================
// PS2
PS2X ps2x;
// ============================================================
// IDLE ANIMATION
bool idleAnimEnabled = true;
unsigned long idleLastStep = 0;
const unsigned long IDLE_STEP_MS = 80;
int idleColIndex = 0;
byte idleFrame[8] = {0,0,0,0,0,0,0,0};
// ============================================================
// SAFE SERVO WRITE
void writeAllServos() {
  s1.write(currentPos[0]);
  s2.write(currentPos[1]);
  s3.write(currentPos[2]);
  s4.write(currentPos[3]);
  s5.write(currentPos[4]);
}
// ============================================================
// IDLE ANIMATION HELPERS
byte reverseByte(byte b) {
  b = (b & 0xF0) >> 4 | (b & 0x0F) << 4;
  b = (b & 0xCC) >> 2 | (b & 0x33) << 2;
  b = (b & 0xAA) >> 1 | (b & 0x55) << 1;
  return b;
}
void drawFrameFlipped(const byte frame[8]) {
  for (int row = 0; row < 8; row++) {
    lc.setRow(0, row, reverseByte(frame[7 - row]));
  }
}
void idleAnimReset() {
  for (int i = 0; i < 8; i++) idleFrame[i] = 0x00;
  idleColIndex = 0;
  idleLastStep = millis();
  drawFrameFlipped(idleFrame);
}
void idleAnimUpdate() {
  if (!idleAnimEnabled) return;
  unsigned long now = millis();
  if (now - idleLastStep < IDLE_STEP_MS) return;
  idleLastStep = now;
  byte col = 0x00; // blank column for simplicity
  for (int r = 0; r < 8; r++) {
    idleFrame[r] = (idleFrame[r] << 1) | ((col >> r) & 0x01);
  }
  drawFrameFlipped(idleFrame);
  idleColIndex++;
}
// ============================================================
// SETUP
// ============================================================
void setup() {
  Serial.begin(115200);
  lc.shutdown(0,false);
  lc.setIntensity(0,8);
  lc.clearDisplay(0);
  idleAnimEnabled = true;
  idleAnimReset();
  // Attach servos and move safely to home (90°)
  s1.attach(S1_PIN); s1.write(90);
  s2.attach(S2_PIN); s2.write(90);
  s3.attach(S3_PIN); s3.write(90);
  s4.attach(S4_PIN); s4.write(90);
  s5.attach(S5_PIN); s5.write(90);
  delay(1000); // wait for servos to reach home
  // Setup PS2 controller
  int error = ps2x.config_gamepad(PS2_CLK, PS2_CMD, PS2_SEL, PS2_DAT, false, false);
  if(error == 0) Serial.println("PS2 controller found.");
  else Serial.println("PS2 controller not found.");
}
// ============================================================
// LOOP
// ============================================================
void loop() {
  idleAnimUpdate();
  // ---------- PS2 CONTROLLER ----------
  const int JOY_DEADZONE = 10; // ignore tiny joystick movements
  ps2x.read_gamepad(false, 0);
  int newPos[5];
  newPos[0] = map(ps2x.Analog(PSS_LX), 0, 255, 0, 180);
  newPos[1] = map(ps2x.Analog(PSS_LY), 0, 255, 0, 180);
  newPos[2] = map(ps2x.Analog(PSS_RX), 0, 255, 0, 180);
  newPos[3] = map(ps2x.Analog(PSS_RY), 0, 255, 0, 180);
  // Update target positions with deadzone logic and hold positions
  for(int i = 0; i < 4; i++){
    if(abs(newPos[i] - 90) > JOY_DEADZONE){ // joystick moved far enough
      targetPos[i] = newPos[i];             // update target
    } else {
      targetPos[i] = currentPos[i];         // hold current position
    }
  }
  // Buttons for servo 5
  if(ps2x.Button(PSB_PAD_UP)) targetPos[4] = 180;
  else if(ps2x.Button(PSB_PAD_DOWN)) targetPos[4] = 0;
  else targetPos[4] = currentPos[4];        // hold position if no button pressed
  // Constrain servo targets
  for(int i=0;i<5;i++) targetPos[i] = constrain(targetPos[i], MIN_SERVO[i], MAX_SERVO[i]);
  // ---------- SERIAL GUI ----------
  if (Serial.available()) {
    String data = Serial.readStringUntil('\n');
    data.trim();
    if(data.startsWith("DISPLAY:")) {
      // handle display text
    } else {
      int c1 = data.indexOf(',');
      int c2 = data.indexOf(',', c1+1);
      int c3 = data.indexOf(',', c2+1);
      int c4 = data.indexOf(',', c3+1);
      if(c1>0 && c2>0 && c3>0 && c4>0) {
        targetPos[0] = constrain(data.substring(0,c1).toInt(), MIN_SERVO[0], MAX_SERVO[0]);
        targetPos[1] = constrain(data.substring(c1+1,c2).toInt(), MIN_SERVO[1], MAX_SERVO[1]);
        targetPos[2] = constrain(data.substring(c2+1,c3).toInt(), MIN_SERVO[2], MAX_SERVO[2]);
        targetPos[3] = constrain(data.substring(c3+1,c4).toInt(), MIN_SERVO[3], MAX_SERVO[3]);
        targetPos[4] = constrain(data.substring(c4+1).toInt(), MIN_SERVO[4], MAX_SERVO[4]);
      }
    }
  }
  // ---------- SMOOTH SERVO UPDATES ----------
  unsigned long now = millis();
  if(now - lastStepTime >= STEP_DT) {
    lastStepTime = now;
    bool updated = false;
    for(int i=0;i<5;i++) {
      if(currentPos[i] < targetPos[i]) {
        currentPos[i] += STEP_SIZE;
        if(currentPos[i] > targetPos[i]) currentPos[i] = targetPos[i];
        updated = true;
      } else if(currentPos[i] > targetPos[i]) {
        currentPos[i] -= STEP_SIZE;
        if(currentPos[i] < targetPos[i]) currentPos[i] = targetPos[i];
        updated = true;
      }
    }
    if(updated) writeAllServos();
  }
}
